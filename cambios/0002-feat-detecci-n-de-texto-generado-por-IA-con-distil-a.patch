+describe('servicio de background sobre RPC', () => {
+  const host: RuntimeHost = {
+    platform: 'chromium',
+    ensure: async () => {},
+    run: (async () => ({ evidence: [] })) as RuntimeHost['run'],
+    teardown: async () => {},
+  };
+
+  it('responde a una petición válida', async () => {
+    const { a, b } = connectedPair();
+    createBackgroundService(host).serve(b);
