+    );
+    expect(ev?.llr).toBe(2);
+  });
+
+  it('se declara Tier 2, que es lo que lo mantiene fuera del camino rápido', () => {
+    const d = new RemoteSlopDetector(fakeHost((async () => ({ evidence: [] })) as RuntimeHost['run']));
+    expect(d.capabilities.tier).toBe(2);
+  });
+});
